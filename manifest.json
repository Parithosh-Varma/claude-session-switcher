{
  "manifest_version": 3,
  "name": "Claude Session Switcher",
  "version": "1.2.3",
  "description": "Save and fast-switch between multiple claude.ai login sessions.",
  "permissions": ["cookies", "storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["*://*.claude.ai/*", "*://claude.ai/*", "*://*.anthropic.com/*", "*://*.console.anthropic.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "next-account": {
      "suggested_key": { "default": "Alt+Shift+N", "mac": "Alt+Shift+N" },
      "description": "Switch to next Claude account"
    },
    "prev-account": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Switch to previous Claude account"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Session Switcher",
    "default_icon": {
      "16": "icons/claude-16.png",
      "48": "icons/claude-48.png",
      "128": "icons/claude-128.png"
    }
  },
  "icons": {
    "16": "icons/claude-16.png",
    "48": "icons/claude-48.png",
    "128": "icons/claude-128.png"
  }
}
