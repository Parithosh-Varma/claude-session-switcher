{
  "manifest_version": 3,
  "name": "Claude Session Switcher",
  "version": "1.3.0",
  "description": "Save and fast-switch between multiple claude.ai login sessions.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-session-switcher@local",
      "strict_min_version": "131.0"
    }
  },
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://*.claude.ai/*",
    "*://claude.ai/*",
    "*://*.anthropic.com/*",
    "*://*.console.anthropic.com/*",
    "*://*.chatgpt.com/*",
    "*://chatgpt.com/*",
    "*://*.openai.com/*",
    "*://*.auth0.com/*"
  ],
  "background": {
    "scripts": [
      "firefox-shim.js",
      "shared.js",
      "background.js"
    ]
  },
  "commands": {
    "next-account": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Switch to next Claude account"
    },
    "prev-account": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Switch to previous Claude account"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Session Switcher",
    "default_icon": {
      "16": "icons/claude-16.png",
      "48": "icons/claude-48.png",
      "128": "icons/claude-128.png"
    }
  },
  "icons": {
    "16": "icons/claude-16.png",
    "48": "icons/claude-48.png",
    "128": "icons/claude-128.png"
  }
}
